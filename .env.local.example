# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Rakuten Books API (https://webservice.rakuten.co.jp/)
RAKUTEN_APP_ID=

# Web Push VAPID keys — generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:otsuka.05y@gmail.com

# Protects the /api/cron/check-releases route. Vercel automatically sends
# this as a Bearer token when it triggers scheduled Cron Jobs.
CRON_SECRET=

# Single-user login
APP_PASSWORD=
# Random secret used to sign the session cookie (e.g. `openssl rand -base64 32`)
SESSION_SECRET=
